# PostgreSQL + pgvector (Docker listens on host port 5433 to avoid local Postgres conflict)
POSTGRES_DB=enclave_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only

DATABASE_URL=postgresql://enclave_app:enclave_dev_password@localhost:5433/enclave_rag
ADMIN_DATABASE_URL=postgresql://postgres:postgres_dev_only@localhost:5433/enclave_rag

# Auth / JWT
JWT_SECRET_KEY=dev-only-change-this-secret-key-min-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ENABLE_DEMO_MODE=true
APP_BASE_URL=http://localhost:3000

# AI Providers (Groq Chat + Gemini Embeddings)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Object Storage (local | tigris | s3 | r2)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=https://t3.storage.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=enclave-rag-uploads
S3_REGION=auto

# Rate Limiting, Stripe Billing & Optional Invite Email (Resend)
ORG_RATE_LIMIT_PER_MIN=60
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=EnclaveRAG <noreply@enclaverag.local>

# Frontend (dev-only demo page toggle; disabled automatically in production builds)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
